ROXY_WORKSPACE_HOST=career-workbench.example.com
# Set to ip when ROXY_WORKSPACE_HOST is a public IP address.
ROXY_WORKSPACE_TLS_MODE=domain
# public opens the shared workbench without a login.
ROXY_WORKSPACE_ACCESS=private
ROXY_WORKSPACE_USER=roxy
# bcrypt hashes contain dollar signs. Keep the single quotes in this file.
ROXY_WORKSPACE_PASSWORD_HASH=''
LUJIE_SETTINGS_SECRET=''
# Generate with openssl rand -hex 24 before creating the first team.
ROXY_TEAM_SETUP_TOKEN=''
